NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:8787
CORS_ORIGIN=http://localhost:8787,https://yingan1998.github.io

# Persistent account/session database. Use PostgreSQL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/japan_tokyo
DATABASE_SSL=false

# One trip is enough for the current app. Keep this ID stable.
TRIP_ID=japan-tokyo-2026
TRIP_TITLE=2026 東京九天八夜
GOOGLE_SHEET_ID=填入私人 Google 試算表 ID
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"填入","private_key_id":"填入","private_key":"-----BEGIN PRIVATE KEY-----\n填入\n-----END PRIVATE KEY-----\n","client_email":"填入","client_id":"填入","token_uri":"https://oauth2.googleapis.com/token"}

# First deployment only. Run bootstrap-admin, then remove this value.
INITIAL_ADMIN_NAME=旅程管理員
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=請改成至少 10 碼的暫時密碼

# Public frontend origin is used in one-time setup/reset links; API origin is kept for reference.
PUBLIC_APP_ORIGIN=https://yingan1998.github.io/Japan-Tokyo
PUBLIC_API_ORIGIN=http://localhost:8787
SESSION_DAYS=30

