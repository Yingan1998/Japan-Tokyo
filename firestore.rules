rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function memberAfter(tripId, uid) {
      return getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(uid));
    }

    function legacyMemberDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function hasLegacyTokyoMember(tripId) {
      return tripId == 'japan-tokyo-2026' && legacyMemberDoc().exists();
    }

    function memberHasRole(tripId, role) {
      return (memberDoc(tripId).exists() && memberDoc(tripId).data.role == role)
        || (hasLegacyTokyoMember(tripId) && legacyMemberDoc().data.role == role);
    }

    function activeMember(tripId) {
      return signedIn()
        && ((memberDoc(tripId).exists() && memberDoc(tripId).data.status == 'active')
          || (hasLegacyTokyoMember(tripId) && legacyMemberDoc().data.status == 'active'));
    }

    function canWriteTrip(tripId) {
      return activeMember(tripId)
        && (memberHasRole(tripId, 'admin') || memberHasRole(tripId, 'editor'));
    }

    function isTripAdmin(tripId) {
      return activeMember(tripId) && memberHasRole(tripId, 'admin');
    }

    function allowedDataset(datasetId) {
      return datasetId in [
        'itinerary',
        'tickets',
        'flights',
        'accommodations',
        'expenses',
        'reservedExpenses'
      ];
    }

    match /trips/{tripId} {
      allow read: if activeMember(tripId);
      // A new owner creates the trip, their member document and their private
      // trip index together in one batch. getAfter() prevents an orphaned
      // member from being used to claim an existing trip.
      allow create: if signedIn()
        && request.resource.data.id == tripId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.destination is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string;
      // 相容舊東京旅程：早期文件可能尚未有 ownerId，管理員可先更新設定，
      // 但一旦文件已有 ownerId，就不得改成其他帳號。
      allow update: if isTripAdmin(tripId)
        && (!resource.data.keys().hasAny(['ownerId'])
          || request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if false;
    }

    match /trips/{tripId}/members/{uid} {
      // Members are provisioned by Firebase Console, Admin SDK, or a trusted backend.
      // A traveller may read only their own membership document.
      // 只允許本人讀取自己的成員文件，避免 activeMember() 檢查時形成循環判斷。
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn()
        && uid == request.auth.uid
        && memberAfter(tripId, uid).data.status == 'active'
        && memberAfter(tripId, uid).data.role == 'admin'
        && getAfter(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // 舊版東京 App 使用頂層 members/{uid} 儲存旅伴角色；只允許本人讀取，禁止前端修改。
    match /members/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow write: if false;
    }

    match /users/{uid}/tripRefs/{tripId} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.tripId == tripId
        && ((activeMember(tripId) && memberDoc(tripId).data.role == 'admin')
          || (memberAfter(tripId, uid).data.status == 'active'
            && memberAfter(tripId, uid).data.role == 'admin'));
      allow update: if signedIn() && uid == request.auth.uid && activeMember(tripId);
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /trips/{tripId}/datasets/{datasetId} {
      allow read: if allowedDataset(datasetId) && activeMember(tripId);
      allow create: if allowedDataset(datasetId)
        && canWriteTrip(tripId)
        && request.resource.data.tripId == tripId
        && request.resource.data.dataset == datasetId
        && request.resource.data.revision == 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'tripId', 'dataset', 'revision', 'updatedAt', 'updatedBy', 'records'
        ]);
      allow update: if allowedDataset(datasetId)
        && canWriteTrip(tripId)
        && request.resource.data.tripId == tripId
        && request.resource.data.dataset == datasetId
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'tripId', 'dataset', 'revision', 'updatedAt', 'updatedBy', 'records'
        ]);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

